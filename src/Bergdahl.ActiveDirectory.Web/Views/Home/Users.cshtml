@{
    ViewData["Title"] = "Users";
    ViewData["ActivePage"] = "Users";
}

<header class="page-header">
    <h1>Users</h1>
    <p>Create users, change passwords and manage group memberships in an OU.</p>
</header>

<div class="toolbar">
    <label class="field">
        <span>OU or container</span>
        <span class="select">
            <select id="adpath" data-adpath></select>
        </span>
    </label>
    <button class="icon-button" type="button" data-refresh aria-label="Reload users" title="Reload users">
        <span class="icon">refresh</span>
    </button>
</div>

<form class="card" data-create-form novalidate>
    <header class="card-header"><span class="icon">person_add</span><h2>Create user</h2></header>
    <div class="form-grid cols-2">
        <label class="field">
            <span>Login name</span>
            <input name="login" type="text" autocomplete="off" spellcheck="false" required>
            <small class="field-hint">The sAMAccountName, for example jdoe.</small>
        </label>
        <label class="field">
            <span>Password</span>
            <input name="password" type="password" autocomplete="new-password" required>
        </label>
        <label class="field">
            <span>First name</span>
            <input name="first" type="text" autocomplete="off" required>
        </label>
        <label class="field">
            <span>Last name</span>
            <input name="last" type="text" autocomplete="off" required>
        </label>
    </div>
    <div class="form-stack">
        <div class="field-row">
            <label class="field">
                <span>Groups</span>
                <span class="select">
                    <select data-new-user-group>
                        <option value="">Select a group…</option>
                    </select>
                </span>
            </label>
            <button class="button secondary" type="button" data-add-group><span class="icon">add</span>Add</button>
        </div>
        <ul class="chips" data-new-user-groups aria-label="Groups for the new user"></ul>
    </div>
    <div class="form-actions">
        <button class="button" type="submit"><span class="icon">person_add</span>Create user</button>
    </div>
</form>

<div class="card">
    <header class="card-header">
        <span class="icon">group</span><h2>Users</h2>
        <span class="card-header-end" data-count></span>
    </header>
    <label class="field card-filter">
        <span>Filter</span>
        <input type="search" data-filter autocomplete="off" spellcheck="false">
    </label>
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th data-sort="userLoginName"><button class="sort" type="button">Login name<span class="icon">arrow_upward</span></button></th>
                <th data-sort="firstName"><button class="sort" type="button">First name<span class="icon">arrow_upward</span></button></th>
                <th data-sort="lastName"><button class="sort" type="button">Last name<span class="icon">arrow_upward</span></button></th>
                <th class="actions"><span class="visually-hidden">Actions</span></th>
            </tr>
            </thead>
            <tbody data-users>
            <tr class="empty"><td colspan="4">Loading users…</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Change password -->
<dialog class="dialog" id="password-dialog" aria-labelledby="password-title">
    <form data-password-form novalidate>
        <header class="dialog-header">
            <h2 id="password-title">Change password</h2>
            <button class="icon-button" type="button" aria-label="Close" title="Close" data-dialog-close><span class="icon">close</span></button>
        </header>
        <div class="dialog-body">
            <p>New password for <strong data-password-user></strong>.</p>
            <label class="field">
                <span>New password</span>
                <input name="password" type="password" autocomplete="new-password" required>
            </label>
            <label class="field">
                <span>Confirm new password</span>
                <input name="confirm" type="password" autocomplete="new-password" required>
            </label>
            <p class="field-error" data-password-error role="alert"></p>
        </div>
        <div class="form-actions">
            <button class="button secondary" type="button" data-dialog-close>Cancel</button>
            <button class="button" type="submit"><span class="icon">key</span>Change password</button>
        </div>
    </form>
</dialog>

<!-- Group memberships -->
<dialog class="dialog" id="groups-dialog" aria-labelledby="groups-title">
    <header class="dialog-header">
        <h2 id="groups-title">Groups</h2>
        <button class="icon-button" type="button" aria-label="Close" title="Close" data-dialog-close><span class="icon">close</span></button>
    </header>
    <div class="dialog-body">
        <p>Group memberships for <strong data-groups-user></strong>.</p>
        <div>
            <h3>Member of</h3>
            <ul class="list member-list" data-member-list></ul>
        </div>
        <form class="field-row" data-add-member-form>
            <label class="field">
                <span>Add to group</span>
                <span class="select">
                    <select data-member-group>
                        <option value="">Select a group…</option>
                    </select>
                </span>
            </label>
            <button class="button" type="submit"><span class="icon">add</span>Add</button>
        </form>
    </div>
    <div class="form-actions">
        <button class="button secondary" type="button" data-dialog-close>Close</button>
    </div>
</dialog>

@section Scripts {
    <script src="/js/users.js" defer></script>
}
