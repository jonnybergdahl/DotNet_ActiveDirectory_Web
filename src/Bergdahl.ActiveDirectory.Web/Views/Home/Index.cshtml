@{
    ViewData["Title"] = "DNS records";
    ViewData["ActivePage"] = "DNS";
}

<header class="page-header">
    <h1>DNS records</h1>
    <p>Host (A) and alias (CNAME) records in a zone. Host records get a PTR record in the matching reverse zone.</p>
</header>

<div class="toolbar">
    <label class="field">
        <span>Zone</span>
        <span class="select">
            <select id="zone" data-zone></select>
        </span>
    </label>
    <button class="icon-button" type="button" data-refresh aria-label="Reload records" title="Reload records">
        <span class="icon">refresh</span>
    </button>
</div>

<form class="card" data-add-form novalidate>
    <header class="card-header"><span class="icon">add_circle</span><h2>Add record</h2></header>
    <div class="form-grid">
        <label class="field">
            <span>Type</span>
            <span class="select">
                <select name="type" data-record-type>
                    <option value="A" selected>Host (A)</option>
                    <option value="CNAME">Alias (CNAME)</option>
                </select>
            </span>
        </label>
        <label class="field">
            <span>Name</span>
            <input name="name" type="text" autocomplete="off" spellcheck="false" required>
            <small class="field-hint">For example webserver01. The zone is added for you.</small>
        </label>
        <label class="field" data-for-type="A">
            <span>IP address</span>
            <input name="ip" type="text" inputmode="decimal" autocomplete="off" spellcheck="false">
            <small class="field-hint">IPv4, for example 10.0.0.50.</small>
        </label>
        <label class="field" data-for-type="CNAME" hidden>
            <span>Target host</span>
            <span class="select">
                <select name="target" data-target-host>
                    <option value="">Select a host…</option>
                </select>
            </span>
            <small class="field-hint">A host record in this zone.</small>
        </label>
    </div>
    <div class="form-actions">
        <button class="button" type="submit"><span class="icon">add</span>Add record</button>
    </div>
</form>

<div class="card">
    <header class="card-header">
        <span class="icon">dns</span><h2>Records</h2>
        <span class="card-header-end" data-count></span>
    </header>
    <label class="field card-filter">
        <span>Filter</span>
        <input type="search" data-filter autocomplete="off" spellcheck="false">
    </label>
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th data-sort="hostName"><button class="sort" type="button">Name<span class="icon">arrow_upward</span></button></th>
                <th data-sort="recordType"><button class="sort" type="button">Type<span class="icon">arrow_upward</span></button></th>
                <th data-sort="ipAddress"><button class="sort" type="button">IP address / target<span class="icon">arrow_upward</span></button></th>
                <th data-sort="ttl" class="num"><button class="sort" type="button">TTL<span class="icon">arrow_upward</span></button></th>
                <th class="actions"><span class="visually-hidden">Actions</span></th>
            </tr>
            </thead>
            <tbody data-records>
            <tr class="empty"><td colspan="5">Loading records…</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="/js/dns.js" defer></script>
}
