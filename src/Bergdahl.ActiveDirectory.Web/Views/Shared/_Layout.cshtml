@{
    // Shell from Web_Bergdahl_Template. The app name is used in the tab title, top bar and footer.
    const string AppName = "Active Directory Web";
    var activePage = ViewData["ActivePage"]?.ToString();
    string? Current(string page) => activePage == page ? "page" : null;
    var pageTitle = ViewData["Title"]?.ToString();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(pageTitle) ? AppName : $"{pageTitle} · {AppName}")</title>
    <meta name="color-scheme" content="light dark">
    <meta name="csrf-token" content="@Context.Session.GetString("csrf")">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

    <!-- Material Symbols (https://fonts.google.com/icons) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=block">

    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/site.css">
    <script src="/js/theme.js"></script>
    <script src="/js/app.js" defer></script>
    <script src="/js/site.js" defer></script>
    <script src="/js/search.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body>
<div class="app">

    <!-- ===== Top bar: app icon + name left, search centre, action icons right ===== -->
    <header class="topbar">
        <div class="topbar-start">
            <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
                <span class="icon">menu</span>
            </button>
            <a class="app-title" href="/">
                <img class="app-icon" src="/assets/app-icon.svg" alt="" width="32" height="32">
                <span class="app-name">@AppName</span>
            </a>
        </div>

        <!-- Search, centred. js/search.js searches hosts and users; Ctrl/⌘ K focuses it. -->
        <div class="search" data-search>
            <div class="search-field">
                <span class="icon">search</span>
                <input type="search" placeholder="Search hosts and users" aria-label="Search hosts and users" autocomplete="off"
                       role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" data-search-input>
                <kbd class="search-shortcut" data-search-shortcut>Ctrl K</kbd>
                <button class="icon-button search-close" type="button" aria-label="Close search" data-search-close>
                    <span class="icon">close</span>
                </button>
            </div>
            <ul class="search-results" id="search-results" role="listbox" aria-label="Search results" hidden data-search-results></ul>
        </div>

        <div class="topbar-actions">
            <button class="icon-button search-open" type="button" aria-label="Search" title="Search" data-search-open>
                <span class="icon">search</span>
            </button>
            <button class="icon-button" type="button" data-theme-toggle aria-label="Theme: system" title="Theme: system">
                <span class="icon">brightness_auto</span>
            </button>

            <!-- Account menu: always last -->
            <div class="dropdown" data-dropdown>
                <button class="icon-button" type="button" data-dropdown-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="account-menu" aria-label="Account" title="Account">
                    <span class="icon">account_circle</span>
                </button>
                <div class="dropdown-menu" id="account-menu" role="menu" hidden>
                    <div class="dropdown-header">@User.Identity?.Name</div>
                    <a class="dropdown-item" href="/account" role="menuitem"><span class="icon">person</span>Account</a>
                    <button class="dropdown-item" type="button" role="menuitem" data-logout><span class="icon">logout</span>Logout</button>
                </div>
            </div>
        </div>
    </header>

    <!-- ===== Left menu ===== -->
    <nav class="sidebar" id="sidebar" aria-label="Main">
        <ul class="nav">
            <li><a class="nav-link" href="/" aria-current="@Current("DNS")"><span class="icon">dns</span>DNS</a></li>
            <li><a class="nav-link" href="/users" aria-current="@Current("Users")"><span class="icon">group</span>Users</a></li>
        </ul>
    </nav>
    <div class="scrim"></div>

    <main class="main">
        <section class="page">
            @RenderBody()
        </section>
    </main>

    <!-- ===== Bottom bar ===== -->
    <footer class="footer">
        <p>@AppName, Copyright&copy; @DateTime.Now.Year, Jonny Bergdahl, <a href="https://github.com/jonnybergdahl/DotNet_ActiveDirectory_Web">GitHub</a></p>
    </footer>

</div>

<div class="toasts" id="toasts"></div>

<!-- Shared confirm dialog, used by confirmAction() in site.js -->
<dialog class="dialog" id="confirm-dialog" aria-labelledby="confirm-title">
    <form method="dialog">
        <header class="dialog-header">
            <h2 id="confirm-title" data-confirm-title>Confirm</h2>
            <button class="icon-button" type="button" aria-label="Close" title="Close" data-dialog-close><span class="icon">close</span></button>
        </header>
        <div class="dialog-body">
            <p data-confirm-message></p>
        </div>
        <div class="form-actions">
            <button class="button secondary" value="cancel">Cancel</button>
            <button class="button danger" value="ok" data-confirm-ok><span class="icon">delete</span>Delete</button>
        </div>
    </form>
</dialog>
</body>
</html>
